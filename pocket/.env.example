# Odysseus Pocket configuration — copy to ../.env (or export in Termux) and edit.
# Every setting is optional; the app works with defaults + an Ollama model.

# Where the model server lives (any OpenAI-compatible /v1 endpoint).
#   Ollama (default):        http://127.0.0.1:11434/v1
#   LM Studio on this phone: http://127.0.0.1:1234/v1
#   llamafile / llama.cpp:   http://127.0.0.1:8080/v1
#   OpenAI:                  https://api.openai.com/v1
POCKET_BASE_URL=http://127.0.0.1:11434/v1
POCKET_API_KEY=
POCKET_MODEL=

# Web search: auto (default) | duckduckgo | serpapi | none
POCKET_SEARCH_BACKEND=auto
SERPAPI_KEY=

# Shared-secret PIN for the API. Set it when other devices can reach the
# server. The PWA asks for it once in Settings and stores it locally.
POCKET_TOKEN=

# Network binding and storage location.
POCKET_HOST=0.0.0.0
POCKET_PORT=8000
POCKET_DATA_DIR=
